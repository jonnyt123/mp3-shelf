{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mp3-shelf-coordinator",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mp3-shelf-agent-jobs",
      "migrations_dir": "migrations"
    }
  ]
}
